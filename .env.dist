# -----------------------------------------------------------------------------
# Metrics — self-hosted Docker host monitor (SQLite only).
# Requires a readable Docker Engine socket (DOCKER_SOCKET) on the collector.
#
# Compose reads `.env` for ${METRICS_PORT} etc. Recommended:
#   cp .env.dist .env
# -----------------------------------------------------------------------------

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-a-long-random-secret-please

DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/metrics.sqlite"

# Case 1 (standalone): host port published by Compose. Change if 8080 is already taken.
# The dashboard has no built-in authentication, so it stays bound to loopback.
# Set METRICS_BIND=0.0.0.0 to reach it from the LAN (put a reverse proxy in front).
METRICS_BIND=127.0.0.1
METRICS_PORT=8080
DEFAULT_URI=http://localhost:8080

# Case 2 (reverse proxy): set DEFAULT_URI to your public URL, e.g. https://metrics.example.com
# DEFAULT_URI=https://metrics.example.com

COLLECTOR_INTERVAL=30
DOCKER_SOCKET=/var/run/docker.sock

METRICS_RETENTION_DAYS=30
METRICS_LOG_TAIL=500
