# -----------------------------------------------------------------------------
# Default Metrics configuration (Docker host monitor).
# Requires a readable Docker Engine socket (DOCKER_SOCKET).
# SQLite by default. For PostgreSQL/MySQL, set DATABASE_URL to your own instance.
#
# Compose reads a file named `.env` for ${METRICS_PORT} etc. Recommended:
#   cp .env.dist .env
# Container env can still use ENV_FILE=.env (or keep the default .env.dist).
# -----------------------------------------------------------------------------

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-a-long-random-secret-please

# SQLite by default: the file persists in the ./var/data bind mount.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/metrics.sqlite"
# Examples (bring your own server — not started by compose):
# DATABASE_URL="postgresql://metrics:metrics@db:5432/metrics?serverVersion=16&charset=utf8"
# DATABASE_URL="mysql://metrics:metrics@db:3306/metrics?serverVersion=8.0"

# Case 1 (standalone): host port published by Compose. Change if 8080 is already taken.
METRICS_PORT=8080
DEFAULT_URI=http://localhost:8080

# Case 2 (reverse proxy): set DEFAULT_URI to your public URL, e.g. https://metrics.example.com
# DEFAULT_URI=https://metrics.example.com

# Pull collectors (mandatory Docker source).
COLLECTOR_SCHEDULE_ENABLED=1
COLLECTOR_INTERVAL=30
DOCKER_SOCKET=/var/run/docker.sock

# Auto-prune data_point rows older than N days (daily at 03:00, via collector scheduler).
# Set to 0 to disable scheduled age prune (manual: app:data-point:prune).
# Orphan containers (removed from Docker) are GC'd daily at 03:05: app:orphan-containers:prune.
METRICS_RETENTION_DAYS=30

# Last N log lines stored per container (replaced each collector tick). 0 disables log sync.
# 500 keeps enough context for verbose stack traces (Laravel, Symfony, …).
METRICS_LOG_TAIL=500
