<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title>{% block title %}Metrics{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('assets/app.css') }}">
    <script src="{{ asset('assets/vendor/htmx.min.js') }}" defer></script>
    <script src="{{ asset('assets/vendor/idiomorph-ext.min.js') }}" defer></script>
    {% block head %}{% endblock %}
</head>
<body class="layout-v2" hx-ext="morph">
<header class="topbar topbar-compact">
    <a class="brand" href="{{ path('app_dashboard') }}">
        <img class="brand-icon" src="{{ asset('favicon.svg') }}" width="22" height="22" alt="">
        metrics
    </a>
    <div class="topbar-center">{% block topbar_center %}{% endblock %}</div>
    {% block topbar_status %}{% endblock %}
</header>
<main class="layout-main">
    {% block body %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
