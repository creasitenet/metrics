<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title>{% block title %}Metrics{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('assets/app.css') }}">
    <script src="{{ asset('assets/vendor/htmx.min.js') }}" defer></script>
    {% block head %}{% endblock %}
</head>
<body>
<div class="noise" aria-hidden="true"></div>
{% if app.user %}
<header class="topbar">
    <a class="brand" href="{{ path('app_dashboard') }}"><span class="brand-mark">M</span> METRICS</a>
    <div class="topbar-right">
        <span class="status"><i></i> MONITORING</span>
        <span class="user-email">{{ app.user.userIdentifier }}</span>
        <form method="post" action="{{ path('app_logout') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button class="link-button" type="submit">Sign out</button>
        </form>
    </div>
</header>
{% endif %}
<main class="shell {% if not app.user %}shell-auth{% endif %}">
    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="flash flash-{{ type }}">{{ message }}</div>{% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
