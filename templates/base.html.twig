<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title>{% block title %}Metrics{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('assets/app.css') }}">
    <script src="{{ asset('assets/vendor/htmx.min.js') }}" defer></script>
    {% block head %}{% endblock %}
</head>
<body>
<div class="noise" aria-hidden="true"></div>
<header class="topbar">
    <a class="brand" href="{{ path('app_dashboard') }}"><span class="brand-mark">M</span> METRICS</a>
    <div class="topbar-right">
        <span class="status"><i></i> MONITORING</span>
    </div>
</header>
<main class="shell">
    {% block body %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
