{% extends 'base.html.twig' %}

{% block title %}Docker — Metrics{% endblock %}

{% block topbar_center %}
<div id="topbar-host-meta">
    {% include 'dashboard/_topbar_host_meta.html.twig' %}
</div>
{% endblock %}

{% block topbar_status %}
<span class="status-pill{{ collector.ok ? ' is-live' : ' is-stale' }}" title="{% if collector.sampled_at %}Last host sample {{ collector.sampled_at|date('Y-m-d H:i:s T') }}{% else %}Collector has not written host_state yet{% endif %}">
    <i></i> {{ collector.label }}
</span>
{% endblock %}

{% block body %}
{% include 'dashboard/_app_live.html.twig' %}
{% endblock %}

{% block scripts %}
<script src="{{ asset('assets/vendor/chart.umd.min.js') }}"></script>
<script src="{{ asset('assets/charts.js') }}"></script>
<script>
(() => {
  const storeKey = 'metrics.sidebar.groups';
  const readCollapsed = () => {
    try {
      return new Set(JSON.parse(localStorage.getItem(storeKey) || '[]'));
    } catch {
      return new Set();
    }
  };
  const writeCollapsed = (set) => {
    localStorage.setItem(storeKey, JSON.stringify([...set]));
  };
  const applyGroupMemory = (root = document) => {
    const collapsed = readCollapsed();
    root.querySelectorAll('details.sidebar-group').forEach((el) => {
      if (!(el instanceof HTMLDetailsElement)) return;
      const slug = el.dataset.groupSlug || '';
      if (!slug) return;
      el.open = !collapsed.has(slug);
    });
  };

  // Persist only explicit user toggles. Idiomorph re-applies the template's
  // `open` attribute on every refresh; listening to `toggle` would treat that
  // as a user action and erase the stored collapsed state.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const summary = target.closest('summary.sidebar-group-summary');
    if (!(summary instanceof HTMLElement)) return;
    const group = summary.parentElement;
    if (!(group instanceof HTMLDetailsElement)) return;
    const slug = group.dataset.groupSlug || '';
    if (!slug) return;
    // The default <details> toggle runs after the click handler.
    setTimeout(() => {
      const collapsed = readCollapsed();
      if (group.open) {
        collapsed.delete(slug);
      } else {
        collapsed.add(slug);
      }
      writeCollapsed(collapsed);
    }, 0);
  });

  document.addEventListener('DOMContentLoaded', () => applyGroupMemory());
  document.body.addEventListener('htmx:afterSettle', () => applyGroupMemory());

  document.addEventListener('input', (ev) => {
    const input = ev.target;
    if (!(input instanceof HTMLInputElement) || !input.matches('[data-sidebar-filter]')) return;
    const q = input.value.trim().toLowerCase();
    document.querySelectorAll('.sidebar-row').forEach((row) => {
      const hay = [row.dataset.name, row.dataset.image, row.dataset.group, row.dataset.state].join(' ');
      const li = row.closest('li');
      if (li instanceof HTMLElement) {
        li.style.display = q === '' || hay.includes(q) ? '' : 'none';
      }
    });
  });
})();
</script>
{% endblock %}
