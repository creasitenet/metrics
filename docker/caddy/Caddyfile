{
    {$CADDY_GLOBAL_OPTIONS}
    admin off
    servers {
        trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
    }
}

{$SERVER_NAME:localhost} {
    root * /var/www/html/public
    encode zstd gzip
    php_server {
        root /var/www/html/public
        index index.php
        env APP_ENV {$APP_ENV:prod}
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Suppression de l'entête X-Powered-By
        -Server
    }

    @disallowed {
        path /.git*
        path /.env*
        path /vendor/*
        path /var/*
        path /migrations/*
        path /config/*
        path /src/*
        path /tests/*
    }
    respond @disallowed 404
}
