# Variables d'environnement pour l'environnement de test PHPUnit. Une base
# SQLite jetable est utilisée par les tests fonctionnels ; chaque exécution
# démarre sur un fichier frais via le bootstrap des tests.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_ENV=test
APP_DEBUG=1
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/metrics_test.sqlite"
COLLECTOR_INTERVAL=30
DOCKER_SOCKET=/var/run/docker.sock
